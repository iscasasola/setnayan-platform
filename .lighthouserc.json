{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/pricing",
        "http://localhost:3000/login"
      ],
      "startServerCommand": "pnpm --filter @setnayan/web start",
      "numberOfRuns": 1,
      "settings": {
        "emulatedFormFactor": "mobile",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "// rationale": "Thresholds split into two layers. (a) Category gates that stay hard `error` because they're stable + audit-presence-only: a11y / best-practices / SEO. (b) Performance + Core Web Vitals soft-landed to `warn` with thresholds set to current pilot-week measurements + ~10% headroom — so green means 'no regression past today' rather than 'we hit aspirational throttled-emulator targets we never actually hit'. The locked KPI targets per CLAUDE.md 2026-05-22 row 1 are LCP <1.5s · INP <100ms · CLS <0.05 — those are the post-pilot perf-sprint goals, not the V1-pilot CI gate. Ratchet down quarterly after the real perf work (image audit · RSC streaming · bundle slim · long-task profiling) lands.",
      "// login": "2026-11-26 (final check A1-160): /login is deliberately noindex — a sign-in page is a door, not a search result — so Lighthouse's is-crawlable audit fails by design and drags the SEO category to 0.66. /login keeps every other gate and the SEO audits that still apply, one by one; / and /pricing keep the full SEO category gate.",
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*/login$).*$",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.55
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:pwa": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 4500
              }
            ],
            "interactive": [
              "warn",
              {
                "maxNumericValue": 5200
              }
            ],
            "total-blocking-time": [
              "warn",
              {
                "maxNumericValue": 2300
              }
            ],
            "max-potential-fid": [
              "warn",
              {
                "maxNumericValue": 850
              }
            ],
            "cumulative-layout-shift": [
              "warn",
              {
                "maxNumericValue": 0.12
              }
            ],
            "first-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 1800
              }
            ],
            "speed-index": [
              "warn",
              {
                "maxNumericValue": 3400
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/login$",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.55
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:pwa": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 4500
              }
            ],
            "interactive": [
              "warn",
              {
                "maxNumericValue": 5200
              }
            ],
            "total-blocking-time": [
              "warn",
              {
                "maxNumericValue": 2300
              }
            ],
            "max-potential-fid": [
              "warn",
              {
                "maxNumericValue": 850
              }
            ],
            "cumulative-layout-shift": [
              "warn",
              {
                "maxNumericValue": 0.12
              }
            ],
            "first-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 1800
              }
            ],
            "speed-index": [
              "warn",
              {
                "maxNumericValue": 3400
              }
            ],
            "document-title": "error",
            "meta-description": "error",
            "http-status-code": "error",
            "link-text": "error",
            "crawlable-anchors": "error",
            "hreflang": "error",
            "canonical": "error"
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
