# ============================================================================
# ⚠ THIS REPOSITORY IS CHECKED OUT AT THE USER'S HOME DIRECTORY.
#
# That means ~/Documents, ~/Pictures, ~/Downloads, ~/Library, ~/.ssh, ~/.aws,
# ~/.bash_history, ~/.claude.json and every other personal file physically sits
# inside this repo's working tree. A single `git add -A` would stage shell
# history and credential files into a shared repository.
#
# So the root is an ALLOWLIST, not a denylist: everything at the top level is
# ignored, and only the real project paths are added back. This fails CLOSED —
# a new personal file in the home directory is invisible to git by default.
#
# ⚠ CONSEQUENCE: a genuinely NEW top-level project file must be added to the
# allowlist below, or git will silently ignore it. Nested files are unaffected
# (anything under apps/, packages/, supabase/, etc. behaves normally).
# Already-tracked files are never affected by ignore rules.
# ============================================================================
/*

# --- project source ---
!/apps/
!/packages/
!/supabase/
!/scripts/
!/src-tauri/
!/changelog.d/

# --- build + tooling config at the root ---
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/turbo.json
!/tsconfig.base.json
!/serve-vis.cjs
!/visual.html

# --- dotfile config that belongs to the project ---
!/.gitignore
!/.gitattributes
!/.gitleaksignore
!/.editorconfig
!/.prettierrc
!/.nvmrc
!/.env.example
!/.lighthouserc.json
!/.github/
!/.githooks/
# .claude holds per-session personal state; only the committed launch config
# is part of the project.
!/.claude/
/.claude/*
!/.claude/launch.json

# --- project documentation at the root ---
!/*.md
!/LICENSE

# Dependencies
node_modules/
node_modules
.pnpm-store/

# Build output
.next/
.turbo/
dist/
out/
build/

# Tauri
src-tauri/target/
src-tauri/icons/32x32.png
src-tauri/icons/128x128.png
src-tauri/icons/128x128@2x.png
src-tauri/icons/icon.icns
src-tauri/icons/icon.ico
src-tauri/icons/Square*.png
src-tauri/icons/StoreLogo.png
src-tauri/WixTools/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# macOS
.DS_Store

# Coverage / test artifacts
/coverage/
.nyc_output/

# Playwright E2E (Task #35) — install browsers + traces locally;
# CI installs fresh each run. Reports + results are PR-specific artifacts.
/test-results/
/playwright-report/
/playwright/.cache/
apps/web/test-results/
apps/web/playwright-report/
apps/web/playwright/.cache/

# Supabase
supabase/.branches/
supabase/.temp/

*.tsbuildinfo
.vercel
apps/web/supabase/.temp/
