{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Bash(npm run dev*)",
      "Bash(yarn dev*)",
      "Bash(yarn run dev*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm run dev*)",
      "Bash(pnpm --filter * dev*)"
    ],
    "ask": [
      "Bash(npm run build*)",
      "Bash(pnpm build*)",
      "Bash(pnpm run build*)",
      "Bash(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-double-build.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/warn-hardcoded.sh" }
        ]
      }
    ]
  }
}
