
# ── SEO / GEO · owner actions (see /admin/app-performance?tab=seo) ────────────
# Domain-ownership meta tags. MUST use the NEXT_PUBLIC_ prefix — app/layout.tsx
# renders the meta tag from these exact names, and the SEO audit reads the same
# ones via lib/seo/org-same-as.ts. Paste the raw token only, not the whole tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
#
# Search Console DATA pull (fills public.seo_metrics). SEPARATE from the meta
# tag above — verifying ownership does NOT grant API access. Needs an OAuth
# client in a Google Cloud project + a refresh token with the
# webmasters.readonly scope. Until all four are set, runSeoGscPull() no-ops and
# seo_metrics stays empty.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
GSC_SITE_URL=
#
# ADDITIVE extra Organization.sameAs[] profiles, comma-separated. The shipped
# list (Facebook Page) lives in lib/seo/org-same-as.ts and is the floor — this
# only adds to it, so a new profile can go live without a deploy.
SETNAYAN_ORG_SAMEAS=
